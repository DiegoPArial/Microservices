{
    "openapi": "3.0.0",
    "info": {
        "title": "API de Gerenciamento de Tarefas",
        "description": "Esta API permite a criação, edição e remoção de tarefas.",
        "version": "1.0.0",
        "contact": {
            "email": "diprearial@gmail.com"
        },
        "termsOfService": "http://localhost:3001/terms"
    },
    "servers": [
        {
            "url": "http://localhost:3001/api",
            "description": "Servidor Local"
        }
    ],
    "paths": {
        "/tarefas": {
            "post": {
                "summary": "Criar uma nova tarefa",
                "description": "Cria uma nova tarefa no sistema.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "titulo": { "type": "string" },
                                    "descricao": { "type": "string" },
                                    "data_vencimento": { "type": "string", "format": "date" },
                                    "status": { "type": "string" },
                                    "id_usuario": { "type": "integer" }
                                },
                                "required": ["titulo", "descricao", "data_vencimento", "status", "id_usuario"]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Tarefa criada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Tarefa"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Erro ao criar tarefa"
                    }
                }
            }
        },
        "/tarefas/{id_tarefa}": {
            "put": {
                "summary": "Editar uma tarefa",
                "description": "Edita uma tarefa existente pelo ID.",
                "parameters": [
                    {
                        "name": "id_tarefa",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "integer" }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "titulo": { "type": "string" },
                                    "descricao": { "type": "string" },
                                    "data_vencimento": { "type": "string", "format": "date" },
                                    "status": { "type": "string" }
                                },
                                "required": ["titulo", "descricao", "data_vencimento", "status"]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Tarefa editada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Tarefa"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Tarefa não encontrada"
                    },
                    "500": {
                        "description": "Erro ao editar tarefa"
                    }
                }
            },
            "delete": {
                "summary": "Deletar uma tarefa",
                "description": "Remove uma tarefa pelo ID.",
                "parameters": [
                    {
                        "name": "id_tarefa",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "description": "ID da tarefa a ser deletada"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Tarefa deletada com sucesso"
                    },
                    "404": {
                        "description": "Tarefa não encontrada"
                    },
                    "500": {
                        "description": "Erro ao deletar tarefa"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Tarefa": {
                "type": "object",
                "properties": {
                    "id_tarefa": { "type": "integer" },
                    "titulo": { "type": "string" },
                    "descricao": { "type": "string" },
                    "data_criacao": { "type": "string", "format": "date-time" },
                    "data_vencimento": { "type": "string", "format": "date" },
                    "status": { "type": "string" },
                    "id_usuario": { "type": "integer" }
                }
            }
        }
    }
}
